# Copy to .env and adjust. Real environment variables take precedence.

# Astro blog project the "やさしい日本語" posts are exported into
# (posts land in <dir>/src/content/blog/ja/japanese/YYYY/MM/).
VLOGSMITH_BLOG_DIR=~/blog

# Font used for covers and burned-in captions (a .ttc/.ttf with Japanese glyphs).
# VLOGSMITH_FONT=/System/Library/Fonts/Hiragino Sans GB.ttc

# ffmpeg built with libass. Found automatically under Homebrew's ffmpeg-full if unset.
# FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
